# Required: your OpenRouter key (https://openrouter.ai/keys).
# Leave empty to run in free "mock" mode, which fakes the AI step for testing.
OPENROUTER_API_KEY=

# Required: PIN both iPads use to unlock the booth.
BOOTH_PIN=2468

# Optional
EVENT_NAME=Fun Booth
OPENROUTER_MODEL=bytedance-seed/seedream-5-0-flash
# auto = try OpenRouter's /images API, fall back to /chat/completions. Or force: images | chat
OPENROUTER_API_MODE=auto
# 1K is cheaper/faster, 2K prints sharper. Leave empty to use the model default.
OPENROUTER_RESOLUTION=2K
OPENROUTER_TIMEOUT=120
# Date printed on photos uses this time zone (IANA name)
TIMEZONE=Asia/Singapore
# Where photos are stored. On Railway, mount a volume here.
DATA_DIR=./data
# Only needed if the QR codes should point at a custom domain
# PUBLIC_URL=https://booth.example.com
